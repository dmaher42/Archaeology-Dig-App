{
  "name": "archaeology-dig-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src/App.jsx src/main.jsx src/data.js src/components src/styles src/trailer src/utils eslint.config.js vite.config.js",
    "preview": "vite preview",
    "journey:apply-prop-export": "node scripts/apply-journey-prop-export.mjs",
    "journey:write-placement-overrides": "node scripts/apply-journey-prop-export.mjs --overrides src/components/expedition-journey/journeyPlacementOverrides.generated.js",
    "playtest:serve": "node scripts/serve-dist.mjs --host 127.0.0.1 --port 5186",
    "playtest": "npm run build && npm run playtest:serve",
    "trailer:still": "remotion still src/trailer/index.jsx GameTrailer --scale=0.25 --frame=40 output/game-trailer-preview.png",
    "trailer:render": "remotion render src/trailer/index.jsx GameTrailer output/game-trailer.mp4 --codec=h264 --overwrite --timeout=120000"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "canvas": "^3.2.3",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "^4.0.464",
    "@remotion/media": "^4.0.464",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "remotion": "^4.0.464",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0"
  }
}
